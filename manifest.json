{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.4.0",
  "description": "__MSG_extensionDescription__",
  "action": {
    "default_title": "Avaa tai sulje Valmislausekekirjasto"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "permissions": [
    "sidePanel",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "default_locale": "fi",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'"
  }
}
